---
import c from "../content.json";
---
<section class="section wrap manifesto" data-wireframe aria-labelledby="m-h">
    <header class="section-head"><span class="note note--ink">{c.approach.span_1}</span><span class="note" data-wf-note>{c.approach.span_2}</span></header>
    <h2 class="wf" id="m-h">
      <span class="wf-row"><span class="wf-line h1"><span class="outline-text" aria-hidden="true">{c.approach.span_3}</span><span class="wf-solid" data-wf-solid><span class="wf-solid__inner">{c.approach.span_4}</span></span></span><span class="wf-dim note" data-wf-note aria-hidden="true">{c.approach.span_5}</span></span>
      <span class="wf-row"><span class="wf-line h1"><span class="outline-text" aria-hidden="true">{c.approach.span_6}</span><span class="wf-solid" data-wf-solid><span class="wf-solid__inner">{c.approach.span_7}</span></span></span><span class="wf-dim note" data-wf-note aria-hidden="true">{c.approach.span_8}</span></span>
      <span class="wf-row"><span class="wf-line h1"><span class="outline-text" aria-hidden="true">{c.approach.span_9}</span><span class="wf-solid" data-wf-solid><span class="wf-solid__inner">{c.approach.span_10}</span></span></span><span class="wf-dim note" data-wf-note aria-hidden="true">{c.approach.span_11}</span></span>
    </h2>
    <div class="manifesto__body grid-12"><p class="lead" data-reveal="up">{c.approach.p_12}</p></div>
  </section>
