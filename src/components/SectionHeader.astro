---
import c from "../content.json";
---
<a class="skip note" href="#main">{c.header.a_1}</a>
<div class="preloader" aria-hidden="true">
  <div class="preloader__meta note"><span>{c.header.span_2}</span><span>{c.header.span_3}</span></div>
  <svg class="monogram preloader__mark is-plotting" viewBox="0 0 68 40"><path pathLength="1" d="M4 37 16 3l12 34M8.2 25h15.6" /><path class="monogram__g" pathLength="1" d="M38 37V3h16M38 20h13" /><circle class="monogram__dot" cx="64" cy="36" r="2.6" /></svg>
  <div class="preloader__meta note"><span>{c.header.span_4}</span><span class="preloader__count"></span></div>
</div>
<header class="site-header wrap">
  <a class="brand" href="#top" aria-label="Ada Ferrer, back to top">
    <svg class="monogram brand__mark is-plotting" viewBox="0 0 68 40" aria-hidden="true"><path pathLength="1" d="M4 37 16 3l12 34M8.2 25h15.6" /><path class="monogram__g" pathLength="1" d="M38 37V3h16M38 20h13" /><circle class="monogram__dot" cx="64" cy="36" r="2.6" /></svg>
    <span class="brand__name note note--ink" set:html={c.header.span_5_html}></span>
  </a>
  <nav class="nav" aria-label="Main">
    <ul>
      <li><a class="nav__link" href="#work"><span class="note" aria-hidden="true">{c.header.span_6}</span><span class="nav__label" data-label="Work">{c.header.span_7}</span></a></li>
      <li><a class="nav__link" href="#services"><span class="note" aria-hidden="true">{c.header.span_8}</span><span class="nav__label" data-label="Services">{c.header.span_9}</span></a></li>
      <li><a class="nav__link" href="#process"><span class="note" aria-hidden="true">{c.header.span_10}</span><span class="nav__label" data-label="Process">{c.header.span_11}</span></a></li>
      <li><a class="nav__link" href="#notes"><span class="note" aria-hidden="true">{c.header.span_12}</span><span class="nav__label" data-label="Notes">{c.header.span_13}</span></a></li>
    </ul>
  </nav>
  <div class="tools">
    <button class="tool" type="button" data-action="theme" aria-label="Toggle light / dark theme"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.25" /><path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" /></svg></button>
    <button class="tool" type="button" data-action="accent" aria-label="Change accent colour"><span class="swatch" aria-hidden="true"></span></button>
    <button class="tool tool--kbd note" type="button" data-action="palette" aria-label="Open command palette (Ctrl K)">{c.header.button_14}</button>
    <button class="tool tool--menu note" type="button" data-action="palette" aria-label="Open menu">{c.header.button_15}</button>
    <a class="btn header-cta" href="#contact">{c.header.a_16}</a>
  </div>
  <div class="hd-rule" aria-hidden="true"><span class="hd-rule__fill"><span class="hd-rule__tag note"></span></span></div>
</header>
