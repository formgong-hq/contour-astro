        <span class="service__title h2">{c.services.span_17}</span>
        <span class="service__body">{c.services.span_18}</span>
        <span class="service__tags"><span class="note">{c.services.span_19}</span><span class="note">{c.services.span_20}</span><span class="note">{c.services.span_21}</span></span>
        <span class="service__arrow" aria-hidden="true">→</span>
