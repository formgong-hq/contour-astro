    <ol class="services">
      <li class="service" data-reveal="up"><a class="service__link grid-12" href="#contact" data-fill>
        <span class="service__n note" aria-hidden="true">{c.services.span_3}</span>
        <span class="service__title h2">{c.services.span_4}</span>
        <span class="service__body">{c.services.span_5}</span>
        <span class="service__tags"><span class="note">{c.services.span_6}</span><span class="note">{c.services.span_7}</span><span class="note">{c.services.span_8}</span><span class="note">{c.services.span_9}</span></span>
