---
import c from "../content.json";
---
<!doctype html>
<html lang={c.site.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{c.site.title}</title>
<meta name="description" content={c.site.description}>
<link rel="icon" href="/img/favicon.svg">
<script is:inline>(function(d){d.className="js";d.dataset.accent="blue";try{var t=localStorage.getItem("ct-theme"),a=localStorage.getItem("ct-accent");if(t)d.dataset.theme=t;if(a)d.dataset.accent=a;if(sessionStorage.getItem("ct-preloaded"))d.dataset.preloaded="yes"}catch(e){}})(document.documentElement)</script>
<link rel="stylesheet" href="/site.css">
</head>
<body>
<slot />
<script is:inline src="/site.js" defer></script>
</body>
</html>
