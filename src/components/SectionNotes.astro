---
import c from "../content.json";
---
<section class="section wrap" id="notes" aria-labelledby="n-h">
    <header class="section-head"><h2 class="note note--ink" id="n-h">{c.notes.h2_1}</h2><span class="note">{c.notes.span_2}</span></header>
    <ul class="posts">
      <li data-reveal="up"><a class="post grid-12" href="#notes"><span class="post__date note">{c.notes.span_3}</span><span class="post__title h3">{c.notes.span_4}</span><span class="post__pillar note">{c.notes.span_5}</span></a></li>
      <li data-reveal="up"><a class="post grid-12" href="#notes"><span class="post__date note">{c.notes.span_6}</span><span class="post__title h3">{c.notes.span_7}</span><span class="post__pillar note">{c.notes.span_8}</span></a></li>
      <li data-reveal="up"><a class="post grid-12" href="#notes"><span class="post__date note">{c.notes.span_9}</span><span class="post__title h3">{c.notes.span_10}</span><span class="post__pillar note">{c.notes.span_11}</span></a></li>
    </ul>
  </section>
