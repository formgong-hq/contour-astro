---
import c from "../content.json";
---
<footer class="site-footer wrap">
  <div class="grid-12 footer-top">
    <p class="footer-claim h3" set:html={c.footer.p_1_html}></p>
    <div class="footer-col"><p class="note">{c.footer.p_2}</p><ul><li><a class="link" href="#work">{c.footer.a_3}</a></li><li><a class="link" href="#services">{c.footer.a_4}</a></li><li><a class="link" href="#process">{c.footer.a_5}</a></li><li><a class="link" href="#notes">{c.footer.a_6}</a></li></ul></div>
    <div class="footer-col"><p class="note">{c.footer.p_7}</p><ul><li><a class="link" href="#top" set:html={c.footer.a_8_html}></a></li><li><a class="link" href="#top" set:html={c.footer.a_9_html}></a></li><li><a class="link" href="#top">{c.footer.a_10}</a></li></ul></div>
    <div class="footer-col"><p class="note">{c.footer.p_11}</p><ul><li><a class="link" href="#contact">{c.footer.a_12}</a></li><li><a class="link" href="mailto:hello@example.com">{c.footer.a_13}</a></li></ul></div>
  </div>
  <div class="footer-sign">
    <p class="footer-mark" aria-hidden="true">{c.footer.p_14}</p>
    <div class="tb note"><dl class="tb__cells"><div style="--i:0"><dt>{c.footer.dt_15}</dt><dd class="tb__val"><span>{c.footer.span_16}</span></dd></div><div style="--i:1"><dt>{c.footer.dt_17}</dt><dd class="tb__val"><span>{c.footer.span_18}</span></dd></div><div style="--i:2"><dt>{c.footer.dt_19}</dt><dd class="tb__val"><span>{c.footer.span_20}</span></dd></div></dl><p class="tb__cap"><span>{c.footer.span_21}</span><a class="tb__link" href="#top">{c.footer.a_22}</a></p></div>
  </div>
  <div class="footer-bottom note">
    <p class="copy"><span>{c.footer.span_23}</span><span>{c.footer.span_24}</span></p>
    <span class="hint" set:html={c.footer.span_25_html}></span>
    <nav class="legal-links" aria-label="Legal"><a class="link" href="/privacy/">{c.footer.a_26}</a><a class="link" href="#top">{c.footer.a_27}</a></nav>
  </div>
</footer>
<div class="grid-overlay" aria-hidden="true"><div class="grid-12"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div></div>
